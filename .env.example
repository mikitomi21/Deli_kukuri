# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=password

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Calling: PUBLIC_URL is the public HTTPS host Twilio connects to (WebSocket
# upgrade required): a tunnel in dev (ngrok, profile "tunnel"), and on the VPS
# https://voice.${DOMAIN} exposed by Traefik (compose.deploy.yml, docs/12).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
PUBLIC_URL=
# Required when starting the optional ngrok tunnel profile.
NGROK_AUTHTOKEN=
# Generate a private shared token before enabling the voice gateway.
VOICE_SERVICE_TOKEN=
VOICE_SERVICE_URL=http://voice:3000
CALL_MAX_ATTEMPTS=2
CALL_RETRY_DELAY_MIN=15
MATERIALIZER_HORIZON_H=48
