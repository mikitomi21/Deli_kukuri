# Frontend environment — copy to .env for local overrides (gitignored).
# All values are optional: without a .env the app defaults to the real API
# on http://localhost:8000 (see src/main.tsx and src/hooks/useWards.ts).

# Backend URL (dev default: http://localhost:8000; production = same origin)
VITE_API_URL=http://localhost:8000

# Optional demo mode: "mocks" = in-memory demo data, "empty" = empty-state
# preview. Leave unset (or "0") to use the real API.
# VITE_USE_MOCKS=mocks
